{
	"schemaVersion": 1,
	"id": "sudustrial",
	"version": "${version}",
	"name": "sudustrial",
	"description": "This mode ia about some things that I would like to see in Minecraft and what I can programming on my own.",
	"authors": [
		"Netut"
	],
	"contact": {
		"homepage": "https://github.com/Netut1/Sudustrial",
		"sources": "https://github.com/Netut1/Sudustrial"
	},
	"license": "CC0-1.0",
	"icon": "assets/sudustrial/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.netut.sudustrial.Sudustrial"
		],
		"client": [
			"com.netut.sudustrial.client.SudustrialClient"
		],
		"fabric-datagen": [
			"com.netut.sudustrial.client.SudustrialDataGenerator"
		]
	},
	"mixins": [
		"sudustrial.mixins.json",
		{
			"config": "sudustrial.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}